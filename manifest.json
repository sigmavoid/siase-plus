{
  "manifest_version": 3,
  "name": "SIASE Mejorado",
  "version": "1.0",
  "description": "Mejora la interfaz de inicio de sesión de SIASE.",
  "content_scripts": [
    {
      "matches": [
        "*://deimos.dgi.uanl.mx/cgi-bin/wspd_cgi.sh/login.htm*",
        "*://www.uanl.mx/enlinea/*"
      ],
      "all_frames": true,
      "css": [
        "pages/login/content.css"
      ],
      "js": [
        "pages/login/content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://deimos.dgi.uanl.mx/cgi-bin/wspd_cgi.sh/eselcarrera.htm*"
      ],
      "all_frames": true,
      "css": [
        "pages/eselcarrera/content.css"
      ],
      "js": [
        "pages/eselcarrera/content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://deimos.dgi.uanl.mx/*default*"
      ],
      "all_frames": true,
      "css": [
        "pages/default/content.css"
      ],
      "js": [
        "pages/default/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "CodiSaludo.png"
      ],
      "matches": [
        "*://deimos.dgi.uanl.mx/*",
        "*://www.uanl.mx/*"
      ]
    }
  ]
}